---
/*
 * A terminal window showing agt the way it prints. Pass commands to show
 * prompts; agt output with colour goes through AgtLs instead. Long lines
 * scroll inside the window rather than wrapping. The title bar's copy button
 * copies the commands, one per line, without their prompts.
 */
interface Props {
	/** The program named in the title bar: "agt" or "shell". */
	title?: string;
	commands: string[];
	class?: string;
}

const { title = 'agt', commands, class: className } = Astro.props;
const label = commands.length > 1 ? 'Copy commands' : 'Copy command';
---

<figure class:list={['agtd-term not-content', className]}>
	<div class="agtd-term-bar">
		{title}
		<button type="button" class="agtd-term-copy" data-copy={commands.join('\n')} data-label={label} aria-label={label} title={label}>
			<svg class="idle" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"></rect><path d="M5 15V6a2 2 0 0 1 2-2h9"></path></svg>
			<svg class="done" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>
		</button>
	</div>
	<pre class="agtd-term-body">{commands.map((cmd, i) => <>{i > 0 && '\n'}<span class="agtd-t-dim">❯</span> {cmd}</>)}</pre>
</figure>

<script>
	document.querySelectorAll<HTMLButtonElement>('.agtd-term-copy').forEach((btn) => {
		let timer: ReturnType<typeof setTimeout> | undefined;
		btn.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(btn.dataset.copy ?? '');
			} catch {
				return;
			}
			btn.dataset.copied = '';
			btn.setAttribute('aria-label', 'Copied');
			btn.title = 'Copied';
			clearTimeout(timer);
			timer = setTimeout(() => {
				delete btn.dataset.copied;
				btn.setAttribute('aria-label', btn.dataset.label ?? 'Copy');
				btn.title = btn.dataset.label ?? 'Copy';
			}, 2000);
		});
	});
</script>
